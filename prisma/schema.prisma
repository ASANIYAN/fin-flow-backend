// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Main dev database - PostgreSQL for dev, SQLite for tests
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               String      @id @default(uuid())
  email            String      @unique
  firstName        String
  lastName         String
  password         String
  role             Role
  isEmailVerified  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  balance          Decimal     @default(0) // The user's wallet balance

  loanApplications Loan[]
  fundedLoans      Loan[]      @relation("FundedLoans")
  transactions     Transaction[]
}

enum Role {
  BORROWER
  LENDER
}


model Transaction {
  id            String          @id @default(uuid())
  amount        Decimal
  type          TransactionType // e.g., DEPOSIT, DEBIT, DISBURSEMENT
  description   String?
  createdAt     DateTime        @default(now())

  // Link to the user who owns the transaction
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?
  
  // Link to the loan involved in the transaction
  loan          Loan?           @relation(fields: [loanId], references: [id])
  loanId        String?
}


enum TransactionType {
  DEPOSIT
  FUNDING_DEBIT   // Lender's wallet debit when funding a loan
  FUNDING_CREDIT  // Credit to the loan's balance (not a user's wallet)
  DISBURSEMENT    // Borrower's wallet credit when a loan is funded
  WITHDRAWAL
}


model Loan {
  id              String   @id @default(uuid())
  title           String
  description     String?
  amountRequested Decimal
  amountFunded    Decimal  @default(0)
  interestRate    Decimal
  duration        Int // in months
  status          LoanStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Link to the user who created the loan (the Borrower)
  borrower      User      @relation(fields: [borrowerId], references: [id])
  borrowerId    String

  // Link to the user who funded the loan (the Lender)
  fundedBy      User[]    @relation("FundedLoans")

  Transaction Transaction[]
}

enum LoanStatus {
  PENDING
  FUNDING
  FUNDED
  COMPLETED
  CANCELLED
}

