generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  password             String
  isEmailVerified      Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  firstName            String
  lastName             String
  verificationToken    String?       @unique
  emailVerifiedAt      DateTime?
  availableBalance     Decimal       @default(0) @db.Decimal(10, 2)
  escrowBalance        Decimal       @default(0) @db.Decimal(10, 2)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?       @unique
  loanApplications     Loan[]
  transactions         Transaction[]
  fundedLoans          Loan[]        @relation("FundedLoans")
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
  userId      String?
  loanId      String?
  externalRef String?         @unique
  loan        Loan?           @relation(fields: [loanId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])
}

model Loan {
  id              String        @id @default(uuid())
  title           String
  description     String?
  amountRequested Decimal       @db.Decimal(10, 2)
  amountFunded    Decimal       @default(0) @db.Decimal(10, 2)
  interestRate    Decimal       @db.Decimal(5, 2)
  duration        Int
  status          LoanStatus    @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  borrowerId      String
  durationUnit    DurationUnit  @default(MONTHS)
  totalInterest   Decimal       @db.Decimal(10, 2)
  principalRepaid Decimal       @default(0) @db.Decimal(10, 2)
  borrower        User          @relation(fields: [borrowerId], references: [id])
  Transaction     Transaction[]
  fundedBy        User[]        @relation("FundedLoans")
}

enum TransactionType {
  DEPOSIT
  FUNDING_COMMIT
  FUNDING_RELEASE
  DISBURSEMENT
  REPAYMENT
  WITHDRAWAL
}

enum LoanStatus {
  PENDING
  FUNDING
  FULLY_FUNDED
  ACTIVE
  REPAID
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}
