// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// Main dev database - PostgreSQL for dev, SQLite for tests
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               String      @id @default(uuid())
  email            String      @unique
  firstName        String
  lastName         String
  password         String
  role             Role
  isEmailVerified  Boolean     @default(false)
  emailVerifiedAt  DateTime?   // Timestamp when email was verified
  verificationToken String?    @unique  // Token for email verification
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
 
  availableBalance Decimal     @default(0) @db.Decimal(10, 2) // Funds ready for use/withdrawal
  escrowBalance    Decimal     @default(0) @db.Decimal(10, 2) // Funds committed to PENDING/FUNDING loans

    // Security Fields
  // It is optional (`?`) because it is null when not in use.
  resetPasswordToken    String?       @unique
  resetPasswordExpires  DateTime?

  loanApplications Loan[]
  fundedLoans      Loan[]      @relation("FundedLoans")
  transactions     Transaction[]
}

enum Role {
  BORROWER
  LENDER
}


model Transaction {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType // e.g., DEPOSIT, FUNDING_DEBIT, DISBURSEMENT
  description   String?
  externalRef   String?         @unique
  createdAt     DateTime        @default(now())

  // Link to the user who owns the transaction
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?
  
  // Link to the loan involved in the transaction
  loan          Loan?           @relation(fields: [loanId], references: [id])
  loanId        String?
}


enum TransactionType {
  DEPOSIT
  FUNDING_COMMIT   // Lender's available balance is moved to their escrow balance
  FUNDING_RELEASE  // Funds moved from Lender's escrow to Borrower's available balance
  DISBURSEMENT     // Borrower's wallet credit when a loan is fully funded
  REPAYMENT        // Borrower's payment of principal and interest
  WITHDRAWAL
}


model Loan {
  id              String   @id @default(uuid())
  title           String
  description     String?
  amountRequested Decimal       @db.Decimal(10, 2)
  amountFunded    Decimal       @default(0) @db.Decimal(10, 2)
  interestRate    Decimal       @db.Decimal(5, 2)
  duration        Int           // Duration value
  durationUnit    DurationUnit  @default(MONTHS) // Duration unit (DAYS, WEEKS, MONTHS, YEARS)
  totalInterest   Decimal       @db.Decimal(10, 2)
  principalRepaid Decimal       @default(0) @db.Decimal(10, 2) // NEW: Tracks repayment progress
  status          LoanStatus    @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Link to the user who created the loan (the Borrower)
  borrower      User      @relation(fields: [borrowerId], references: [id])
  borrowerId    String

  // Link to the user who funded the loan (the Lender)
  fundedBy      User[]    @relation("FundedLoans")

  Transaction Transaction[]
}

enum LoanStatus {
  PENDING
  FUNDING         // Less than 100% funded
  FULLY_FUNDED    // 100% funded, waiting for disbursement approval
  ACTIVE          // Funds disbursed, repayment period begins
  REPAID          // Final status: Repaid
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}